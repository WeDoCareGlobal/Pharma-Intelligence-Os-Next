{
    "name": "pharma-intelligence-os",
    "version": "0.1.0",
    "type": "module",
    "description": "Pharmacovigilance and regulatory intelligence workspace: ICSR review, E2B(R3) packages, signal management, PSUR/PBRER drafts and FDA approval tracking.",
    "license": "Apache-2.0",
    "author": "Emir Perla",
    "repository": {
        "type": "git",
        "url": "https://github.com/we-do-care-global/pharma-intelligence-os"
    },
    "homepage": "https://we-do-care-global.github.io/pharma-intelligence-os/",
    "bugs": {
        "url": "https://github.com/we-do-care-global/pharma-intelligence-os/issues"
    },
    "keywords": [
        "pharmacovigilance",
        "icsr",
        "e2b",
        "signal-management",
        "regulatory-intelligence",
        "react",
        "typescript"
    ],
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "preview": "vite preview",
        "lint": "eslint src tests --ext .ts,.tsx",
        "typecheck": "tsc --noEmit",
        "test": "vitest run",
        "test:watch": "vitest",
        "verify": "npm run lint && npm run typecheck && npm run test && npm run build"
    },
    "dependencies": {
        "lucide-react": "^0.469.0",
        "react": "^19.0.0",
        "react-dom": "^19.0.0"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "^4.0.0"
    },
    "devDependencies": {
        "@types/node": "^22.10.0",
        "@types/react": "^19.0.0",
        "@types/react-dom": "^19.0.0",
        "@vitejs/plugin-react": "^4.3.0",
        "autoprefixer": "^10.4.0",
        "eslint": "^8.57.0",
        "eslint-plugin-react": "^7.35.0",
        "@typescript-eslint/eslint-plugin": "^7.0.0",
        "@typescript-eslint/parser": "^7.0.0",
        "postcss": "^8.4.0",
        "tailwindcss": "^3.4.0",
        "typescript": "^5.7.0",
        "vite": "^6.0.0",
        "vitest": "^1.0.0"
    }
